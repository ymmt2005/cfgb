{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFGB v1 cfgb",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+$"
        },
        "defaultLocale": {
          "enum": [
            "ja",
            "en"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "baseUrl",
        "defaultLocale",
        "timezone"
      ]
    },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label"
          ]
        },
        "en": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label"
          ]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "default": "src/content"
        },
        "topics": {
          "type": "string",
          "minLength": 1,
          "default": "src/data/topics.yaml"
        },
        "linkcards": {
          "type": "string",
          "minLength": 1,
          "default": "src/data/linkcards"
        }
      },
      "required": []
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latestPosts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5
        }
      },
      "required": []
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "pagefind"
        }
      },
      "required": []
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "gateway": {
          "const": "cloudflare"
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ja": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "provider",
                "model"
              ]
            },
            "en": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "provider",
                "model"
              ]
            }
          }
        }
      },
      "required": []
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previewAccess": {
          "const": true,
          "default": true,
          "description": "Private previews are mandatory in v1; omission also means true. Actual Access policy provisioning is external."
        }
      },
      "required": []
    },
    "hatena": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blogs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "locale": {
                "enum": [
                  "ja",
                  "en"
                ]
              }
            },
            "required": [
              "url",
              "locale"
            ]
          },
          "minItems": 1
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion",
    "site",
    "locales"
  ]
}
