{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFGB v1 migration-conflicts",
  "description": "Observations and proposals only; this report never establishes target ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceUrl",
          "locale",
          "articleKey",
          "targetUrl",
          "reason",
          "observedSourceHash"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "locale": {
            "$ref": "locale-id.schema.json"
          },
          "articleKey": {
            "type": "string",
            "pattern": "^[0-9]{4}/[^/]+$"
          },
          "targetUrl": {
            "type": "string",
            "pattern": "^/(?:[A-Za-z0-9_-]+/)+$"
          },
          "reason": {
            "enum": [
              "unowned-target",
              "source-and-target-changed",
              "concurrent-edit"
            ]
          },
          "lastAppliedSourceHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "lastAppliedTargetHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "observedSourceHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "observedTargetHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "proposedTargetHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "dependentRequired": {
          "lastAppliedSourceHash": [
            "lastAppliedTargetHash"
          ],
          "lastAppliedTargetHash": [
            "lastAppliedSourceHash"
          ]
        }
      }
    }
  }
}
