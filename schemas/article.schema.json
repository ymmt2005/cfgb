{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFGB v1 article",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "description": "Structurally optional/empty during authoring. Semantic validation requires a non-whitespace summary in default and publish modes.",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "ogImage": {
      "type": "string",
      "pattern": "^\\./assets/[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/(?:[A-Za-z0-9_-]+/)+$"
      },
      "description": "Duplicate aliases within/across variants are rejected by semantic validation as E_ALIAS_DUPLICATE in every validation mode."
    }
  },
  "required": [
    "title",
    "slug",
    "publishedAt",
    "topics"
  ]
}
