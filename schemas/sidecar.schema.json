{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFGB v1 sidecar",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "outputHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "promptVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceHash",
                "outputHash",
                "provider",
                "model",
                "promptVersion"
              ]
            },
            "import": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "const": "hatena"
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "provider",
                "sourceUrl",
                "sourceId",
                "sourceHash"
              ]
            }
          },
          "required": []
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "variants"
  ]
}
