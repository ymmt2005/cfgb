---
import { archiveParts, formatDate, loadSite } from "../lib/load-site.mjs";
import type { PostEntry } from "../lib/content";

interface Props {
  locale: string;
  posts: PostEntry[];
}
const { locale, posts } = Astro.props;
const { site, topics } = loadSite();
---
<ol class="post-list">
  {posts.map((post) => {
    const month = archiveParts(post.data.publishedAt, site.timezone);
    return (
      <li>
        <p class="post-meta"><a href={`/${locale}/archive/${month.year}/${month.month}/`}>{formatDate(post.data.publishedAt, locale, site.timezone)}</a></p>
        <h2><a href={post.url}>{post.data.title}</a></h2>
        {post.data.summary && <p class="summary">{post.data.summary}</p>}
        <p class="topics">
          {post.data.topics.map((topic: string) => (
            <a href={`/${locale}/topics/${topic}/`}>{topics[topic]?.[locale] || topic}</a>
          ))}
        </p>
      </li>
    );
  })}
</ol>
