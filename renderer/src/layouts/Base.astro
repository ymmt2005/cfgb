---
import { absolute, loadSite, ui } from "../lib/load-site.mjs";

interface Props {
  locale: string;
  title: string;
  description?: string;
  path: string;
  alternatePath?: string;
  untranslated?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  showAside?: boolean;
  pagefind?: boolean;
  jsonLd?: Record<string, unknown> | null;
}
const {
  locale,
  title,
  description = "",
  path,
  alternatePath = "",
  untranslated = false,
  headings = [],
  showAside = false,
  pagefind = false,
  jsonLd = null,
} = Astro.props;
const { site, routes } = loadSite();
const copy = ui[locale] || ui.en;
const other = Object.keys(site.locales).find((item) => item !== locale) || "";
const otherPath = other
  ? routes.has(swapLocale(path, locale, other))
    ? swapLocale(path, locale, other)
    : `/${other}/`
  : "";
const canonical = absolute(site, path);
const pageTitle = path === `/${locale}/` ? site.title : `${title} · ${site.title}`;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = toc.length > 0;
const topicNav = [...routes].filter((route) => route.startsWith(`/${locale}/topics/`)).sort()[0] || `/${locale}/posts/`;
const nav = [
  [copy.home, `/${locale}/`],
  [copy.posts, `/${locale}/posts/`],
  [copy.archive, `/${locale}/archive/`],
  [copy.topics, topicNav],
  [copy.search, `/${locale}/search/`],
  [copy.about, `/${locale}/about/`],
];
function swapLocale(route: string, from: string, to: string) {
  if (route === `/${from}/` || route.startsWith(`/${from}/`)) return `/${to}/${route.slice(from.length + 2)}`;
  return `/${to}/`;
}
function currentNav(href: string) {
  if (href === `/${locale}/`) return path === href;
  if (href.includes("/topics/") && path.includes("/topics/")) return true;
  return path === href || path.startsWith(href);
}
const json = jsonLd ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c") : "";
---
<!DOCTYPE html>
<html lang={locale}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/rss+xml" title={copy.feed} href={`/${locale}/feed.xml`}>
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical}>
<meta property="og:type" content={pagefind ? "article" : "website"}>
<meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"}>
<meta property="og:site_name" content={site.title}>
{alternatePath && <link rel="alternate" hreflang={other} href={absolute(site, alternatePath)} />}
{alternatePath && <link rel="alternate" hreflang={locale} href={canonical} />}
<link rel="stylesheet" href="/assets/site.css">
<script is:inline src="/assets/theme-boot.js"></script>
{json && <script type="application/ld+json" is:inline set:html={json} />}
</head>
<body>
<a class="skip" href="#content">{copy.skip}</a>
<header class="mast">
  <div class="wrap">
    <div class="mast-row">
      <a class="brand" href={`/${locale}/`}>{site.title.split(" ")[0]} <span>{site.title.split(" ").slice(1).join(" ")}</span></a>
      <div class="tools">
        <nav class="locales" aria-label={copy.language}>
          <a href={path} aria-current="true" hreflang={locale}>{site.locales[locale].label}</a>
          {other && <a href={alternatePath || otherPath} hreflang={other}>{site.locales[other].label}</a>}
        </nav>
        <div class="menu">
          <button class="menu-button" id="theme" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="theme-list">{copy.theme}</button>
          <ul class="menu-list" id="theme-list" role="listbox" hidden>
            <li role="option" tabindex="-1" data-value="system">{copy.system}</li>
            <li role="option" tabindex="-1" data-value="light">{copy.light}</li>
            <li role="option" tabindex="-1" data-value="dark">{copy.dark}</li>
          </ul>
        </div>
      </div>
    </div>
    <nav class="sections" aria-label={copy.sections}>
      {nav.map(([label, href]) => (
        <a href={href} aria-current={currentNav(href) ? "page" : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
<main id="content">
  <div class:list={["wrap", "frame", hasToc && "frame-article", !showAside && "frame-no-rail"]}>
    {hasToc && (
      <details class="toc toc-desktop" open>
        <summary>{copy.toc}</summary>
        <ol>
          {toc.map((heading) => (
            <li class={heading.depth === 3 ? "sub" : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </details>
    )}
    <div class="frame-main">
      <slot name="before" />
      {alternatePath && <p class="translation">{copy.hasTranslation} <a href={alternatePath}>{copy.openTranslation}</a></p>}
      {untranslated && <p class="translation">{copy.noTranslation}</p>}
      {hasToc && (
        <details class="toc-mobile" open>
          <summary>{copy.toc}</summary>
          <ol>
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? "sub" : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}
      <slot />
    </div>
    {showAside && <aside class="rail"><slot name="aside" /></aside>}
  </div>
</main>
<footer class="site"><div class="wrap"><span>{site.title} · {new URL(site.baseUrl).host}</span><span><a href={`/${locale}/feed.xml`}>{copy.feed}</a></span></div></footer>
<script is:inline src="/assets/site.js"></script>
<script>
  const blocks = document.querySelectorAll("pre.mermaid");
  async function draw() {
    if (!blocks.length) return;
    const mermaid = (await import("mermaid")).default;
    const dark = document.documentElement.getAttribute("data-theme") === "dark"
      || (!document.documentElement.hasAttribute("data-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
    mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: dark ? "dark" : "neutral" });
    for (const block of blocks) {
      if (!block.dataset.source) block.dataset.source = block.textContent || "";
      const source = block.dataset.source;
      const id = "m" + Math.random().toString(36).slice(2);
      try {
        const result = await mermaid.render(id, source);
        block.innerHTML = result.svg;
        document.documentElement.classList.add("mermaid-ready");
      } catch (error) {
        block.textContent = source;
        const note = document.createElement("p");
        note.className = "mermaid-source";
        note.textContent = error instanceof Error ? error.message : "Mermaid error";
        block.insertAdjacentElement("afterend", note);
      }
    }
  }
  draw();
  document.addEventListener("cfgb-theme", () => { draw(); });
</script>
</body>
</html>
