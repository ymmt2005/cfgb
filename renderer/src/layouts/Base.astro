---
import { alternateMembers, languageDestination } from "../lib/locale-link.mjs";
import { absolute, basePath, sitePath, copyFor, loadSite, openGraphLocale } from "../lib/load-site.mjs";

interface Props {
  locale: string;
  title: string;
  description?: string;
  path: string;
  counterparts?: Record<string, string>;
  untranslated?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  showAside?: boolean;
  pagefind?: boolean;
  jsonLd?: Record<string, unknown> | null;
}
const {
  locale,
  title,
  description = "",
  path,
  counterparts,
  untranslated = false,
  headings = [],
  showAside = false,
  pagefind = false,
  jsonLd = null,
} = Astro.props;
const { site, routes } = loadSite();
const copy = copyFor(locale);
const languages = Object.keys(site.locales);
const members = alternateMembers(counterparts);
const translations = members.filter((item) => item.locale !== locale);
const canonical = absolute(site, path);
const pageTitle = path === `/${locale}/` ? site.title : `${title} · ${site.title}`;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = toc.length > 0;
const topicNav = [...routes].filter((route) => route.startsWith(`/${locale}/topics/`)).sort()[0] || `/${locale}/posts/`;
const nav = [
  [copy.home, `/${locale}/`],
  [copy.posts, `/${locale}/posts/`],
  [copy.archive, `/${locale}/archive/`],
  [copy.topics, topicNav],
  [copy.search, `/${locale}/search/`],
  [copy.about, `/${locale}/about/`],
];
function localeChoice(lang: string, destination: string) {
  if (site.static) return sitePath(site, destination);
  return `${sitePath(site, "/__locale")}?lang=${encodeURIComponent(lang)}&next=${encodeURIComponent(destination)}`;
}
function currentNav(href: string) {
  if (href === `/${locale}/`) return path === href;
  if (href.includes("/topics/") && path.includes("/topics/")) return true;
  return path === href || path.startsWith(href);
}
const json = jsonLd ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c") : "";
---
<!DOCTYPE html>
<html lang={locale} data-cfgb-base-path={basePath(site)}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/rss+xml" title={copy.feed} href={sitePath(site, `/${locale}/feed.xml`)}>
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical}>
<meta property="og:type" content={pagefind ? "article" : "website"}>
<meta property="og:locale" content={openGraphLocale(locale)}>
<meta property="og:site_name" content={site.title}>
{members.filter((item) => item.locale !== locale).map((item) => (
  <link rel="alternate" hreflang={item.locale} href={absolute(site, item.href)} />
))}
{members.some((item) => item.locale === locale) && <link rel="alternate" hreflang={locale} href={canonical} />}
<link rel="stylesheet" href={sitePath(site, "/assets/site.css")}>
<script is:inline src={sitePath(site, "/assets/theme-boot.js")}></script>
{json && <script type="application/ld+json" is:inline set:html={json} />}
</head>
<body data-pagefind-ignore={pagefind ? undefined : "all"}>
<a class="skip" href="#cfgb-content">{copy.skip}</a>
<header class="mast">
  <div class="wrap">
    <div class="mast-row">
      <a class="brand" href={sitePath(site, `/${locale}/`)}>{site.title.split(" ")[0]} <span>{site.title.split(" ").slice(1).join(" ")}</span></a>
      <div class="tools">
        {languages.length > 1 ? (
          <details class="language-switch">
            <summary aria-label={`${copy.language}: ${site.locales[locale].label}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
              <span lang={locale}>{site.locales[locale].label}</span><span class="language-chevron" aria-hidden="true">⌄</span>
            </summary>
            <nav aria-label={copy.language}>
              <ul class="language-list">
                {languages.map((language) => (
                  <li><a href={localeChoice(language, languageDestination({ path, locale, destination: language, counterparts, routes }))} hreflang={language} lang={language} aria-current={language === locale ? "true" : undefined}>
                    <span>{site.locales[language].label}</span>
                    {language === locale && <span aria-hidden="true">✓</span>}
                    {counterparts && language !== locale && !Object.hasOwn(counterparts, language) && <small lang={locale}>{copy.home}</small>}
                  </a></li>
                ))}
              </ul>
            </nav>
          </details>
        ) : <span class="language-single" lang={locale}>{site.locales[locale].label}</span>}
        <div class="menu">
          <button class="menu-button" id="cfgb-theme" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="cfgb-theme-list">{copy.theme}</button>
          <ul class="menu-list" id="cfgb-theme-list" role="listbox" aria-labelledby="cfgb-theme" hidden>
            <li role="option" tabindex="-1" data-value="system">{copy.system}</li>
            <li role="option" tabindex="-1" data-value="light">{copy.light}</li>
            <li role="option" tabindex="-1" data-value="dark">{copy.dark}</li>
          </ul>
        </div>
      </div>
    </div>
    <nav class="sections" aria-label={copy.sections}>
      {nav.map(([label, href]) => (
        <a href={sitePath(site, href)} aria-current={currentNav(href) ? "page" : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
<main id="cfgb-content">
  <div class:list={["wrap", "frame", hasToc && "frame-article", !showAside && "frame-no-rail"]}>
    {hasToc && (
      <details class="toc toc-desktop" open>
        <summary>{copy.toc}</summary>
        <ol>
          {toc.map((heading) => (
            <li class={heading.depth === 3 ? "sub" : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </details>
    )}
    <div class="frame-main">
      <slot name="before" />
      {translations.length > 0 && <p class="translation">{copy.hasTranslation} {translations.map((item) => <a href={sitePath(site, item.href)} lang={item.locale} hreflang={item.locale}>{site.locales[item.locale].label}</a>)}</p>}
      {untranslated && <p class="translation">{copy.noTranslation}</p>}
      {hasToc && (
        <details class="toc-mobile" open>
          <summary>{copy.toc}</summary>
          <ol>
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? "sub" : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}
      <slot />
    </div>
    {showAside && <aside class="rail"><slot name="aside" /></aside>}
  </div>
</main>
<footer class="site"><div class="wrap"><span>{site.title} · {new URL(site.baseUrl).host}</span><span><a href={sitePath(site, `/${locale}/feed.xml`)}>{copy.feed}</a></span></div></footer>
<script is:inline src={sitePath(site, "/assets/site.js")}></script>
<script>
  import { localizeDates } from "../lib/dates.mjs";
  localizeDates(document);
  import { createThemeQueue } from "../lib/theme-queue.mjs";
  import { watchSystemTheme } from "../lib/system-theme.mjs";
  const blocks = document.querySelectorAll("pre.mermaid");
  const requestDraw = createThemeQueue(async (current) => {
    if (!blocks.length || !current()) return;
    const mermaid = (await import("mermaid")).default;
    if (!current()) return;
    const dark = document.documentElement.getAttribute("data-theme") === "dark"
      || (!document.documentElement.hasAttribute("data-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
    mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: dark ? "dark" : "neutral" });
    for (const block of blocks) {
      if (!current()) return;
      if (!block.dataset.source) block.dataset.source = block.textContent || "";
      const source = block.dataset.source;
      if (block.nextElementSibling?.classList.contains("mermaid-error")) block.nextElementSibling.remove();
      const id = "m" + Math.random().toString(36).slice(2);
      try {
        const result = await mermaid.render(id, source);
        if (!current()) return;
        block.innerHTML = result.svg;
      } catch (error) {
        if (!current()) return;
        block.textContent = source;
        const note = document.createElement("p");
        note.className = "mermaid-error";
        note.textContent = error instanceof Error ? error.message : "Mermaid error";
        block.insertAdjacentElement("afterend", note);
      }
    }
  });
  requestDraw();
  document.addEventListener("cfgb-theme", () => { requestDraw(); });
  watchSystemTheme(
    window.matchMedia("(prefers-color-scheme: dark)"),
    () => !document.documentElement.hasAttribute("data-theme"),
    requestDraw,
  );
</script>
</body>
</html>
